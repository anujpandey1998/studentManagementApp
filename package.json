{
  "name": "studentManagementApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint:foundation": "eslint App.tsx src/app src/components src/features src/services src/store src/theme src/types/domain.ts src/types/env.d.ts __tests__ --max-warnings=0",
    "format:check": "prettier --check App.tsx babel.config.js src/app src/components src/features src/services src/store src/theme src/types/domain.ts src/types/env.d.ts __tests__",
    "prepare": "husky",
    "backend:start": "supabase start",
    "backend:status": "supabase status",
    "backend:reset": "supabase db reset --local",
    "backend:stop": "supabase stop",
    "backend:test": "powershell -NoProfile -File scripts/check-backend.ps1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "^12.0.2",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/react-native": "^8.30.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "axios": "^1.20.0",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.87.1",
    "react-native-dotenv": "^5.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.28.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-redux": "^9.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^15.5.2",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "supabase": "^2.120.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
